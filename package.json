{
  "name": "flowcarbon",
  "private": true,
  "description": "Occupancy-driven after-hours energy management for office buildings.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "npm run generate -w @flowcarbon/db",
    "db:migrate": "npm run migrate -w @flowcarbon/db && npm run install-schema -w @flowcarbon/jobs",
    "seed": "npm run seed -w @flowcarbon/demo --",
    "snapshot": "tsx scripts/export-snapshot.ts",
    "db:up": "docker compose -f infra/docker-compose.yml up -d db",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "dev:api": "npm run dev -w @flowcarbon/api",
    "dev:worker": "npm run dev -w @flowcarbon/worker"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
