# Copy to .env (never commit it). All services read their settings from the environment.

# --- database -----------------------------------------------------------------------------------
# owner role: migrations, reference data and job-queue schema only
DATABASE_MIGRATION_URL=postgres://flowcarbon:flowcarbon-dev@localhost:5432/flowcarbon
# runtime role (NOBYPASSRLS): API and worker
DATABASE_URL=postgres://flowcarbon_app:flowcarbon-app-dev@localhost:5432/flowcarbon

# --- API ----------------------------------------------------------------------------------------
PORT=4000
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
# COOKIE_SECURE defaults to true in production; set TRUST_PROXY=true behind a reverse proxy
# METRICS_TOKEN=a-long-random-string
# "keep me signed in" sessions: days unused, and at most (other sessions: SESSION_IDLE_HOURS=12, SESSION_MAX_DAYS=7)
# SESSION_REMEMBER_DAYS=30
# SESSION_REMEMBER_MAX_DAYS=90
# outgoing mail through an SMTP relay (submission port 465 or 587; cloud servers usually cannot send on port 25).
# Without it there are no email codes; in development mail is printed to the API log instead.
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# MAIL_FROM="FlowCarbon <you@gmail.com>"

# --- worker -------------------------------------------------------------------------------------
# AI explanations are optional; without a key, explanation requests are marked failed
# ANTHROPIC_API_KEY=
# needed only for keys that are not scoped to a workspace
# ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
NIGHTLY_LOCAL_HOUR=4

# --- demo seed and pump ---------------------------------------------------------------------------
# DEMO_PASSWORD=choose-a-password
# PUMP_INTERVAL_MINUTES=15

# --- docker compose (infra/.env) -----------------------------------------------------------------
# FLOWCARBON_VERSION=0.1.4
# POSTGRES_PASSWORD=   APP_DB_PASSWORD=
# public origin; with the edge profile also DOMAIN=fc.example.org and COOKIE_SECURE=true
# PUBLIC_URL=https://fc.example.org
# ports bind to 127.0.0.1 by default: DB_BIND, API_BIND, WEB_BIND
# memory caps: DB_MEM_LIMIT=1g API_MEM_LIMIT=512m WORKER_MEM_LIMIT=512m WEB_MEM_LIMIT=512m PUMP_MEM_LIMIT=384m
# PG_SHARED_BUFFERS=128MB PG_EFFECTIVE_CACHE_SIZE=512MB
