# Copy to .env (never commit it). All services read their settings from the environment.

# --- database -----------------------------------------------------------------------------------
# owner role: migrations, reference data and job-queue schema only
DATABASE_MIGRATION_URL=postgres://flowcarbon:flowcarbon-dev@localhost:5432/flowcarbon
# runtime role (NOBYPASSRLS): API and worker
DATABASE_URL=postgres://flowcarbon_app:flowcarbon-app-dev@localhost:5432/flowcarbon

# --- API ----------------------------------------------------------------------------------------
PORT=4000
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
# COOKIE_SECURE defaults to true in production; set TRUST_PROXY=true behind a reverse proxy
# METRICS_TOKEN=a-long-random-string

# --- worker -------------------------------------------------------------------------------------
# AI explanations are optional; without a key, explanation requests are marked failed
# ANTHROPIC_API_KEY=
# needed only for keys that are not scoped to a workspace
# ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
NIGHTLY_LOCAL_HOUR=4

# --- demo seed ----------------------------------------------------------------------------------
# DEMO_PASSWORD=choose-a-password
