<?xml version="1.0" encoding="utf-8"?>
<!-- long-press the app icon: straight to a page; /go/<page> finds the organisation and building -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_findings"
        android:shortcutId="findings"
        android:shortcutLongLabel="@string/shortcut_findings"
        android:shortcutShortLabel="@string/shortcut_findings">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://flowcarbon.veritybench.org/go/findings"
            android:targetClass="org.veritybench.flowcarbon.MainActivity"
            android:targetPackage="org.veritybench.flowcarbon" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_floors"
        android:shortcutId="floors"
        android:shortcutLongLabel="@string/shortcut_floors"
        android:shortcutShortLabel="@string/shortcut_floors">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://flowcarbon.veritybench.org/go/floors"
            android:targetClass="org.veritybench.flowcarbon.MainActivity"
            android:targetPackage="org.veritybench.flowcarbon" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_requests"
        android:shortcutId="requests"
        android:shortcutLongLabel="@string/shortcut_requests"
        android:shortcutShortLabel="@string/shortcut_requests">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://flowcarbon.veritybench.org/go/requests"
            android:targetClass="org.veritybench.flowcarbon.MainActivity"
            android:targetPackage="org.veritybench.flowcarbon" />
    </shortcut>
</shortcuts>
