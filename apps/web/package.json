{
  "name": "@flowcarbon/web",
  "version": "0.2.3",
  "private": true,
  "description": "FlowCarbon web application.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
