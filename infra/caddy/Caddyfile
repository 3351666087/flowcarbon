# One public origin: the API under /api/v1, everything else to the web app.
# Certificates are issued and renewed automatically for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	handle /api/v1/* {
		reverse_proxy api:4000
	}
	# files placed in infra/download, e.g. the Android APK: /download/FlowCarbon.apk
	handle_path /download/* {
		root * /srv/download
		header Content-Disposition attachment
		# Android installs from a download only when it is labelled as a package
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
